#!/usr/bin/env bash
# Fail if anything employer-specific or secret is about to be committed.
#
# The pattern lives here only. CLAUDE.md and CI both call this script rather
# than inlining a copy — three copies of a regex means three chances for them
# to drift, and a doc that quotes the pattern trips its own check.
set -uo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1

PATTERN='lacework|fortinet|forticnapp|prodn1|corporate-ca|api\.openai|gho_[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# local/ is gitignored by design. This script self-excludes: it contains the
# pattern by definition.
if hits="$(grep -rInE "$PATTERN" \
      --exclude-dir=.git \
      --exclude-dir=local \
      --exclude=hstack-secret-sweep \
      . 2>/dev/null)"; then
  echo "secret sweep failed — these should not be committed:" >&2
  echo "$hits" >&2
  exit 1
fi

# Installers that append to ~/.zshrc write into dotfiles/zshrc, because it is a
# symlink into this repo. They use absolute /Users/<name> paths, which are both
# private and broken on any other machine. claude-mem, nvm and SDKMAN all do
# this. Catch it before it reaches a commit.
if drift="$(grep -rIn '/Users/' dotfiles/ 2>/dev/null)"; then
  echo "dotfiles contain absolute home paths. An installer probably wrote to" >&2
  echo "your .zshrc, which is a symlink into this repo. Replace them with" >&2
  echo "\$HOME, or move the lines to local/zshrc.local:" >&2
  echo "$drift" >&2
  exit 1
fi

echo "secret sweep clean"
